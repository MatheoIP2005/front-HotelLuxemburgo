{
  "expo": {
    "name": "Hotel Luxemburgo",
    "slug": "hotel-luxemburgo-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "apiBaseUrl": "https://hotellux-gateway.onrender.com/api/v1"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "La app accede a tu galería para subir imágenes de sucursales y habitaciones."
        }
      ],
      "expo-secure-store"
    ]
  }
}
